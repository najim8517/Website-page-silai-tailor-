<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
<style>
html{
background-color:#245791;
/*change-1menue par click karne par page ko smooth scrall karne ke liye add kiya gaya*/
scroll-behavior:smooth;
}
.heading{
font-family:times new roman;
width:800px;
height:25px;
margin-top:0px;
padding:0px;
background-color:none;
color:#00FF00;
font-size:9px;

}
/*menue bar ka hissa*/
ul{

width:170%;
list-style-type:none;
/*bullet point hatane ke liye*/
margin:0;
padding:0;
background-color:#006666;
display:flex;
/*har ek tag ko shidhi line me lane ke liye*/
}
li a {
display:block;
color:white;
padding:5px;
text-decoration:none;/*niche ki line ko hatane ke liye*/
font-weight:bold;
font-size:20px;
/*change 2 menue botton ka size and co;or dhire se badalne ke liye transition add kiya gya*/
transition:background-color 0.3s ease,transform 0.2s ease;

}
/*tab par toch karne se color change ho to hover tag use*/
/*[change-3] phonr par touch(:active)karne parbhi effect dhikhe,iske liye li a:active add kiya gya*/

li a:hover,li a:active{
background-color:#004d4d;
transform:scale(1.05);/*touch
karne par button thodha big hoga*/

}
/*[change-4 new add kiya gya]sbhi picture
par touch karne se zoom hone ka animation*/
img{
border-radius:8px;/*photo ke kinare ko halka
gool karne ke liye*/
transition:transform 0.3s ease,box-shadow 0.3s ease;
}
img:hover,img:active{
transform:scale(1.08);/*photo chone par
big hogi*/
box-shadow:0 6px 15px rgba(0,0,0,0.5);/*photo ke 
piche parchai dikhegi*/
}
/*change-5 new add ki hu/ offer 
wale heading ke 
chamakne/zoom/pulse vala animation*/
@keyframes offerGlow{
0%{transform:scale(1);}
50%{transform:scale(1.03);
text-shadow: 0 0 8px #00ff00;}
100%{transform:scale(1);}
}
.offer-title{
color:#00ff00;
font-size:20px;
display:inline-block;
animation:offerGlow 2s infinite
ease-in-out;
}
/*change-6 new add kiya hamne
products photo ke liye float wala animation*/
@keyframes softFloat{
0%{transform:translatey(0px);}
50%{transform:
translatey(-6px);}
100%{transform:
translatey(0px);}
}
.product-img,desiner-img{
height:250px;
width:300px;
margin:20px;
/*change7 .product-img me
oper bnaya gya softFloat animation
lagu kiya gya*/
animation:softFloat 3s infinite
ease-in-out;
}

</style>
</head>
